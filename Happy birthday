<!DOCTYPE html>
<html lang="th">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>สุขสันต์วันเกิดคุณพ่อ</title>
  <link href="https://googleapis.com" rel="stylesheet">
  
  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      font-family: 'Prompt', sans-serif;
    }

    body {
      background: linear-gradient(135deg, #1e3c72 0%, #2a5298 100%);
      min-height: 100vh;
      display: flex;
      justify-content: center;
      align-items: center;
      padding: 20px;
      color: #333;
      overflow-x: hidden;
    }

    .card {
      background: #ffffff;
      max-width: 500px;
      width: 100%;
      border-radius: 24px;
      padding: 40px 30px;
      text-align: center;
      box-shadow: 0 20px 40px rgba(0, 0, 0, 0.25);
      position: relative;
      animation: fadeIn 1s ease-out;
    }

    @keyframes fadeIn {
      from { opacity: 0; transform: translateY(20px); }
      to { opacity: 1; transform: translateY(0); }
    }

    .badge {
      display: inline-block;
      background: #fdf2e9;
      color: #d35400;
      padding: 6px 16px;
      border-radius: 50px;
      font-size: 14px;
      font-weight: 600;
      margin-bottom: 15px;
      border: 1px solid #f5cba7;
    }

    h1 {
      color: #1e3c72;
      font-size: 28px;
      font-weight: 700;
      margin-bottom: 10px;
    }

    .subtitle {
      color: #666;
      font-size: 16px;
      margin-bottom: 25px;
    }

    .photo-frame {
      width: 160px;
      height: 160px;
      margin: 0 auto 25px;
      border-radius: 50%;
      border: 5px solid #f39c12;
      padding: 5px;
      background-color: #ecf0f1;
      box-shadow: 0 8px 20px rgba(243, 156, 18, 0.3);
      overflow: hidden;
      display: flex;
      justify-content: center;
      align-items: center;
    }

    .photo-frame img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      border-radius: 50%;
    }

    .message-box {
      background: #f8f9fa;
      border-left: 4px solid #f39c12;
      padding: 20px;
      border-radius: 12px;
      margin-bottom: 25px;
      text-align: left;
      line-height: 1.7;
      font-size: 16px;
      color: #444;
      display: none;
      animation: slideDown 0.6s ease-out;
    }

    @keyframes slideDown {
      from { opacity: 0; transform: translateY(-10px); }
      to { opacity: 1; transform: translateY(0); }
    }

    .signature {
      margin-top: 15px;
      text-align: right;
      font-weight: 600;
      color: #1e3c72;
    }

    .btn {
      background: linear-gradient(to right, #f39c12, #e67e22);
      color: white;
      border: none;
      padding: 14px 32px;
      font-size: 18px;
      font-weight: 600;
      border-radius: 50px;
      cursor: pointer;
      box-shadow: 0 6px 15px rgba(230, 126, 34, 0.4);
      transition: transform 0.2s, box-shadow 0.2s;
    }

    .btn:hover {
      transform: translateY(-2px);
      box-shadow: 0 8px 20px rgba(230, 126, 34, 0.5);
    }

    .btn:active {
      transform: translateY(0);
    }
  </style>
</head>
<body>

  <div class="card">
    <div class="badge">🎉 วันพิเศษของคนพิเศษ</div>
    <h1>สุขสันต์วันเกิดครับพ่อ!</h1>
    <p class="subtitle">ขอให้เป็นอีกปีที่เต็มไปด้วยความสุขและรอยยิ้ม</p>

    <!-- กรอบรูปภาพ (แก้ไขให้ใช้แท็ก img เรียบร้อย) -->
    <div class="photo-frame">
      <img src="IMG_DAD.JPG" alt="รูปคุณพ่อ">
    </div>

    <div class="message-box" id="wishMessage">
      <p>
        สุขสันต์วันเกิดเด้อพ่อขอให้มีความสุขหลายๆเงินทองไหลมาเทมากัาวหน้าในหน้าที่การงานเด้อพ่อ
      </p>
      <div class="signature">รักพ่อนะครับ ❤️</div>
    </div>

    <button class="btn" id="celebrateBtn" onclick="openCard()">🎁 กดเพื่อเปิดคำอวยพร</button>
  </div>

  <script src="https://jsdelivr.net"></script>
  <script>
    function openCard() {
      const messageBox = document.getElementById('wishMessage');
      const btn = document.getElementById('celebrateBtn');
      
      messageBox.style.display = 'block';
      btn.innerText = '🎂 จุดพลุฉลองให้พ่ออีกครั้ง!';

      if (typeof confetti === 'function') {
        confetti({
          particleCount: 100,
          spread: 70,
          origin: { y: 0.6 }
        });
      }
    }
  </script>

</body>
</html>
